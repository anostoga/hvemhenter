# Kopier til .env og fyll inn faktiske verdier (aldri commit .env).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
TOKEN_ENCRYPTION_KEY=
STATE_SIGNING_SECRET=
FRONTEND_URL=http://localhost:3000

# Postgres (Supabase lokalt/i prod) — eneste database, se docker-compose.yml lokalt
DATABASE_URL=jdbc:postgresql://localhost:5432/barnehage
DATABASE_USER=postgres
DATABASE_PASSWORD=localdev
FAMILY_CREATION_CODE=
# Egen hemmelighet for signering av sesjonscookien, IKKE samme verdi som STATE_SIGNING_SECRET.
SESSION_SIGNING_SECRET=
# false lokalt (http://localhost, Secure-cookies sendes ikke over http), true i prod (Fly.io/Vercel).
SESSION_COOKIE_SECURE=false
# KUN lokal dev — lar deg logge inn via /auth/mock-login uten en ekte Google OAuth-klient.
# ALDRI sett denne i Fly.io/Vercel-hemmeligheter. Se README "Mock Google-innlogging (lokal dev)".
MOCK_GOOGLE_AUTH=false
# Komma-separert liste over e-poster som automatisk får admin-tilgang (/admin) ved
# innlogging — se AuthRoutes.promoteToAdminIfConfigured. Tom/ubesatt betyr ingen
# automatisk forfremmelse (is_admin må da settes direkte i databasen).
ADMIN_EMAILS=
